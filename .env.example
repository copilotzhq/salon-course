# Optional: the salon's agent on OpenAI. Without it, agents answer with the offline fake model.
OPENAI_API_KEY=
# Optional: what MCP's ids are sealed with (32 bytes or more). Without it, a new one each start.
SALON_SECRET=
# Optional: where the app is, when it isn't this machine (a tunnel's https address, for ChatGPT).
SALON_ORIGIN=
# Optional: a WhatsApp number open to anyone (Meta's Cloud API): its phone number id, an access
# token, the Meta app's secret, and the token Meta's webhook check is answered with.
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_SECRET=
WHATSAPP_VERIFY=
