# Optional: the salon's agent on OpenAI. Without it, agents answer with the offline fake model.
OPENAI_API_KEY=
# What MCP's and the site's ids are sealed with (32 bytes or more: openssl rand -hex 32). Keep
# one: without it, a new one each start, and assistants' and visitors' chats start over.
SALON_SECRET=
# Optional: where the app is, when it isn't this machine (a tunnel's https address, for ChatGPT).
SALON_ORIGIN=
# Optional: a WhatsApp number open to anyone (Meta's Cloud API): its phone number id, an access
# token, the Meta app's secret, and the token Meta's webhook check is answered with.
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_SECRET=
WHATSAPP_VERIFY=
# Optional: PostgreSQL (postgres://user:password@host:5432/database). Without it, a SQLite file:
# .data/salon.sqlite, or where SALON_DATA says. SALON_REVISION: each deploy's number, for the lease.
DATABASE_URL=
SALON_DATA=
SALON_REVISION=
# Online (a public SALON_ORIGIN): Sam's email, invited to sign in, and Resend's key and sender.
SALON_STAFF=
RESEND_API_KEY=
SALON_FROM=
# Online: how many proxies before the app append to x-forwarded-for (Cloud Run's: 1).
SALON_HOPS=
